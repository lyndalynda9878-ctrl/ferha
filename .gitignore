#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — aucune clé ne doit entrer dans le dépôt
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
key.properties
android/key.properties

# Localisation générée depuis les fichiers ARB (recréée par `flutter pub get`)
/lib/core/l10n/generated/

# Configuration locale : URL et cle publique Supabase.
# env.example.json, lui, est versionne et sert de modele.
env.json

# Artefacts de la CLI Supabase (recrees a chaque appel, jamais versionnes).
supabase/.temp/
